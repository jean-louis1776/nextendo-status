<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NexStatus" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/app_background</item>
        <item name="postSplashScreenTheme">@style/Theme.NexStatus.Main</item>
    </style>

    <style name="Theme.NexStatus.Main" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorBackground">@color/app_background</item>
    </style>
</resources>
